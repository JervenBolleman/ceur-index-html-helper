<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>swiss.sib.swissprot</groupId>
	<artifactId>ceur-index-html-helper</artifactId>
	<packaging>jar</packaging>
	<version>1.0-SNAPSHOT</version>
	<name>ceur-index-html-helper</name>
	<url>http://maven.apache.org</url>
	<properties>
		<native.maven.plugin.version>0.11.0</native.maven.plugin.version>
		<graalvm.version>25.4.4.1.1</graalvm.version>
		<!-- native-image of an Oracle GraalVM 25+ for the wasm profile, override with -Dnative-image=/path/to/bin/native-image -->
		<native-image>native-image</native-image>
		<!-- binaryen's optimizer for the wasm profile, override with -Dwasm-opt=/path/to/wasm-opt -->
		<wasm-opt>wasm-opt</wasm-opt>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.github.jervenbolleman</groupId>
			<artifactId>sjh</artifactId>
			<version>0.3.0-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>com.github.jtidy</groupId>
			<artifactId>jtidy</artifactId>
			<version>1.0.5</version>
		</dependency>
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>pdfbox</artifactId>
			<version>3.0.7</version>
		</dependency>
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>fontbox</artifactId>
			<version>3.0.7</version>
		</dependency>
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>jbig2-imageio</artifactId>
			<version>3.0.4</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.rdf4j</groupId>
			<artifactId>rdf4j-rio-rdfxml</artifactId>
			<version>5.2.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.rdf4j</groupId>
			<artifactId>rdf4j-rio-turtle</artifactId>
			<version>5.2.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.rdf4j</groupId>
			<artifactId>rdf4j-model-api</artifactId>
			<version>5.2.0</version>
		</dependency>
		<dependency>
			<!-- Pure Java zlib, replaces the native zlib in the WebAssembly build -->
			<groupId>com.jcraft</groupId>
			<artifactId>jzlib</artifactId>
			<version>1.1.3</version>
		</dependency>
		<dependency>
			<!-- Substitution annotations for the WebAssembly build, provided by native-image -->
			<groupId>org.graalvm.nativeimage</groupId>
			<artifactId>svm</artifactId>
			<version>25.0.4</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<!-- Only used by the WebAssembly entry point swiss.sib.swissprot.web.WebMain -->
			<groupId>org.graalvm.sdk</groupId>
			<artifactId>webimage-preview</artifactId>
			<version>${graalvm.version}</version>
		</dependency>
		<dependency>
			<groupId>info.picocli</groupId>
			<artifactId>picocli</artifactId>
			<version>4.7.6</version>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<version>1.7.36</version>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-text</artifactId>
			<version>1.15.0</version>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>2.15.2</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.jgit</groupId>
			<artifactId>org.eclipse.jgit</artifactId>
			<version>7.6.0.202603022253-r</version>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- the native-image builder (provided, for substitution annotations) can't load on a plain JVM -->
					<classpathDependencyExcludes>
						<classpathDependencyExclude>org.graalvm.nativeimage:*</classpathDependencyExclude>
						<classpathDependencyExclude>org.graalvm.compiler:*</classpathDependencyExclude>
						<classpathDependencyExclude>org.graalvm.truffle:*</classpathDependencyExclude>
						<classpathDependencyExclude>org.graalvm.espresso:*</classpathDependencyExclude>
						<classpathDependencyExclude>org.graalvm.sdk:nativeimage</classpathDependencyExclude>
						<classpathDependencyExclude>org.graalvm.sdk:nativeimage-libgraal</classpathDependencyExclude>
						<classpathDependencyExclude>org.graalvm.sdk:word</classpathDependencyExclude>
						<classpathDependencyExclude>org.graalvm.sdk:collections</classpathDependencyExclude>
					</classpathDependencyExcludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<release>21</release>
					<verbose>true</verbose>
					<annotationProcessorPaths>
						<path>
							<groupId>info.picocli</groupId>
							<artifactId>picocli-codegen</artifactId>
							<version>4.7.6</version>
						</path>
					</annotationProcessorPaths>
					<compilerArgs>
						<!-- @JS annotated methods in WebMain refer to their parameters by name -->
						<arg>-parameters</arg>
						<!-- WebImageFeature adds a single charset through the native-image builder -->
						<arg>--add-exports=org.graalvm.nativeimage.builder/com.oracle.svm.hosted.jdk.localization=oa2cuer</arg>
						<arg>-Aproject=${project.groupId}/${project.artifactId}</arg>
					</compilerArgs>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.5.1</version>
				<configuration>
					<filters>
						<filter>
							<artifact>*:*</artifact>
							<excludes>
								<exclude>META-INF/*.SF</exclude>
								<exclude>META-INF/*.DSA</exclude>
								<exclude>META-INF/*.RSA</exclude>
							</excludes>
						</filter>
					</filters>
				</configuration>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<shadedArtifactAttached>true</shadedArtifactAttached>
							<shadedClassifierName>uber</shadedClassifierName>
							<transformers>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<manifestEntries>
										<Multi-Release>true</Multi-Release>
									</manifestEntries>
									<mainClass>swiss.sib.swissprot.CEUR</mainClass>
								</transformer>
							</transformers>
							<outputFile>
								${project.build.directory}/${project.artifactId}-${project.version}-uber.jar</outputFile>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.5.4</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-source-plugin</artifactId>
					<version>3.3.1</version>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-jar-plugin</artifactId>
					<version>3.4.2</version>
					<configuration>
						<archive>
							<index>true</index>
							<manifest>
								<mainClass>swiss.sib.swissprot.App</mainClass>
								<addDefaultEntries />
							</manifest>
						</archive>
					</configuration>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-javadoc-plugin</artifactId>
					<version>3.6.3</version>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-resources-plugin</artifactId>
					<version>3.3.1</version>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.14.0</version>
				</plugin>
				<plugin>
					<groupId>net.revelc.code.formatter</groupId>
					<artifactId>formatter-maven-plugin</artifactId>
					<version>2.27.0</version>
				</plugin>
			</plugins>
		</pluginManagement>


	</build>
	<profiles>
		<profile>
			<!-- Browser version: mvn -Pwasm package, then serve target/web over http.
			     Requires the native-image of Oracle GraalVM 25+ (with the svm-wasm tool) on the PATH or -Dnative-image=...,
			     and binaryen's wasm-opt on the PATH or -Dwasm-opt=... -->
			<id>wasm</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<version>3.5.0</version>
						<executions>
							<execution>
								<id>web-image</id>
								<phase>package</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>${native-image}</executable>
									<workingDirectory>${project.build.directory}</workingDirectory>
									<arguments>
										<argument>--tool:svm-wasm</argument>
										<!-- the page starts the VM itself, once the files are selected -->
										<argument>-H:-AutoRunVM</argument>
										<!-- enables the substitutions in swiss.sib.swissprot.web, e.g. jzlib instead of zlib for PDFBox -->
										<argument>-Dceur.web-image=true</argument>
										<!-- registers only make-index for picocli, and the Windows-1252 charset PDFBox uses -->
										<argument>--features=swiss.sib.swissprot.web.WebImageFeature</argument>
										<argument>--add-exports=org.graalvm.nativeimage.builder/com.oracle.svm.hosted.jdk.localization=ALL-UNNAMED</argument>
										<!-- picocli's generated config registers all subcommands, making all their code reachable -->
										<argument>--exclude-config</argument>
										<argument>.*${project.artifactId}.*\.jar</argument>
										<argument>META-INF/native-image/picocli-generated/.*</argument>
										<!-- glyph lists, font metrics and cmaps used for text extraction -->
										<argument>-H:IncludeResources=org/apache/(pdfbox|fontbox)/resources/.*</argument>
										<!-- PDFBox touches java.awt.image classes, their static initializers load the native awt library -->
										<argument>--initialize-at-build-time=java.awt.image.BufferedImage,java.awt.image.ColorModel,java.awt.image.IndexColorModel,java.awt.image.Kernel,java.awt.image.Raster,java.awt.image.SampleModel,java.awt.image.SinglePixelPackedSampleModel,sun.awt.image.BufImgSurfaceData,sun.awt.image.ByteComponentRaster,sun.awt.image.BytePackedRaster,sun.awt.image.GifImageDecoder,sun.awt.image.ImageRepresentation,sun.awt.image.IntegerComponentRaster,sun.awt.image.JPEGImageDecoder,sun.awt.image.ShortComponentRaster</argument>
										<argument>-cp</argument>
										<argument>${project.build.directory}/${project.artifactId}-${project.version}-uber.jar</argument>
										<argument>swiss.sib.swissprot.web.WebMain</argument>
										<argument>-o</argument>
										<argument>${project.build.directory}/web/${project.artifactId}</argument>
									</arguments>
								</configuration>
							</execution>
							<execution>
								<!-- optimize for size, about 10% smaller -->
								<id>wasm-opt</id>
								<phase>package</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>${wasm-opt}</executable>
									<arguments>
										<!-- only the features the module uses: with more enabled wasm-opt may
										     emit instructions browsers don't support yet -->
										<argument>--mvp-features</argument>
										<argument>--enable-gc</argument>
										<argument>--enable-reference-types</argument>
										<argument>--enable-exception-handling</argument>
										<argument>--enable-bulk-memory</argument>
										<argument>--enable-nontrapping-float-to-int</argument>
										<argument>--enable-sign-ext</argument>
										<argument>-Oz</argument>
										<argument>${project.build.directory}/web/${project.artifactId}.js.wasm</argument>
										<argument>-o</argument>
										<argument>${project.build.directory}/web/${project.artifactId}.js.wasm</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<!-- native-image always writes a huge debugging .wat text version of the module -->
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<version>3.1.0</version>
						<executions>
							<execution>
								<id>remove-wat</id>
								<phase>package</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target>
										<delete file="${project.build.directory}/web/${project.artifactId}.js.wat" />
									</target>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-resources-plugin</artifactId>
						<executions>
							<execution>
								<id>web-page</id>
								<phase>prepare-package</phase>
								<goals>
									<goal>copy-resources</goal>
								</goals>
								<configuration>
									<outputDirectory>${project.build.directory}/web</outputDirectory>
									<resources>
										<resource>
											<directory>src/main/web</directory>
										</resource>
									</resources>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.junit</groupId>
				<artifactId>junit-bom</artifactId>
				<version>6.0.3</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>
